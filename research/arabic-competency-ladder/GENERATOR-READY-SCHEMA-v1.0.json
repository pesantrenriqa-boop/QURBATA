      "name": "string",
      "learner_operation": "string",
      "definition": "string",
      "prerequisites": {"hard": [], "soft": []},
      "feature_ceiling": "Knn",
      "allowed_operations": [],
      "forbidden_future_operations": [],
      "generator": {
        "example_types": ["word", "phrase", "clause", "verse-span"],
        "question_types": ["recognition", "identify", "classify", "segment", "relation", "contrast", "short-response", "guided-analysis"],
        "difficulty": ["easy", "standard", "advanced-within-ceiling"],
        "default_example_count": 5,
        "default_question_count": 10,
        "ambiguity_max": "medium"
      },
      "extension": {"supersedes": null, "children": [], "tags": []}
    }
  },
  "example_record": {
    "required": ["example_id", "competency_id", "registry_version", "source", "span_ar", "target_operation", "features_required", "ceiling_check"],
