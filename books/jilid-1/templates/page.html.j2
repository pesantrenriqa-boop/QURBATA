<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ identity.title }} — Jilid {{ volume }} Halaman {{ '%02d'|format(page) }}</title>
  <link rel="stylesheet" href="{{ css_uri }}">
</head>
<body>
<main class="page">
  <header class="header">
    <div class="brand-block" aria-label="Identitas QURBATA">
      <img class="brand-logo" src="{{ logo_uri }}" alt="Logo QURBATA">
    </div>
    <div class="heading">
      <div class="subtitle">{{ identity.subtitle }}</div>
      <div class="ornament" aria-hidden="true"><span></span><b>◇</b><span></span></div>
    </div>
    <div class="page-number">{{ '%02d'|format(page) }}</div>
  </header>

  <section class="targets" aria-label="Target capaian halaman">
    <div class="targets-label">TARGET CAPAIAN</div>
    <div class="target-item"><span>Progres materi</span><strong>{{ targets.material_progress }}</strong></div>
    <div class="target-item"><span>Hafalan surat</span><strong>{{ targets.memorization }}</strong></div>
    <div class="target-item"><span>Nidom / Hadits</span><strong>{{ targets.nidom_hadith }}</strong></div>
    <div class="target-item"><span>Bahasa Arab</span><strong>{{ targets.arabic_language }}</strong></div>
  </section>

  <section class="material-title" lang="ar" aria-label="Judul materi">
    <div class="title-ornament" aria-hidden="true"></div>
    <div class="material-title-text">
      {% for item in material_title %}<span class="arabic-token">{{ item }}</span>{% endfor %}
    </div>
    <div class="title-ornament" aria-hidden="true"></div>
  </section>

  <section class="exercise-area" aria-label="Latihan membaca">
    <section class="exercise-section singles-section">
      <div class="group-label">HURUF TUNGGAL</div>
      <div class="group singles">
        {% for item in objects.singles %}<div class="object"><span class="arabic-token">{{ item }}</span></div>{% endfor %}
      </div>
    </section>
    <section class="exercise-section pairs-section">
      <div class="group-label">2 HURUF TERPISAH</div>
      <div class="group pairs">
        {% for item in objects.pairs %}<div class="object">{% for token in item %}<span class="arabic-token">{{ token }}</span>{% endfor %}</div>{% endfor %}
      </div>
    </section>
    <section class="exercise-section triples-section">
      <div class="group-label">3 HURUF TERPISAH</div>
      <div class="group triples">
        {% for item in objects.triples %}<div class="object">{% for token in item %}<span class="arabic-token">{{ token }}</span>{% endfor %}</div>{% endfor %}
      </div>
    </section>
  </section>

  <footer class="footer">
    <div class="field"><strong>{{ footer.teacher_label }}</strong><span class="line"></span></div>
    <div class="field"><strong>{{ footer.date_label }}</strong><span class="line"></span></div>
    <div class="field"><strong>{{ footer.score_label }}</strong><span class="line"></span></div>
  </footer>
  <div class="bottom-band"></div>
</main>
</body>
</html>
