<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ identity.title }} — Jilid {{ volume }} Halaman {{ '%02d'|format(page) }}</title>
  <link rel="stylesheet" href="{{ css_uri }}">
</head>
<body>
<main class="page" data-qae-profile="{{ qae.profile }}">
  <header class="header">
    <div class="brand-block" aria-label="Identitas QURBATA"><img class="brand-logo" src="{{ logo_uri }}" alt="Logo QURBATA"></div>
    <div class="heading"><div class="subtitle">{{ identity.subtitle }}</div><div class="ornament" aria-hidden="true"><span></span><b>◇</b><span></span></div></div>
    <div class="page-number">{{ '%02d'|format(page) }}</div>
  </header>

  <section class="targets" aria-label="Target capaian halaman">
    <div class="targets-label">TARGET CAPAIAN</div>
    <div class="target-item"><span>Progres materi</span><strong>{{ targets.material_progress }}</strong></div>
    <div class="target-item"><span>Hafalan surat</span><strong>{{ targets.memorization }}</strong></div>
    <div class="target-item"><span>Nidom / Hadits</span><strong>{{ targets.nidom_hadith }}</strong></div>
    <div class="target-item"><span>Bahasa Arab</span><strong>{{ targets.arabic_language }}</strong></div>
  </section>

  {% macro qae_token(token) -%}
  <span class="arabic-token qae-token" style="{{ token.style }}" aria-label="{{ token.source }}">
    <span class="arabic-base">{{ token.base }}</span>
    <svg class="qae-mark qae-fathah" viewBox="{{ token.svg.view_box }}" aria-hidden="true" focusable="false">
      <path d="{{ token.svg.path_d }}" fill="none" stroke="{{ token.svg.color }}" stroke-width="{{ token.svg.stroke_width }}" stroke-linecap="round" />
    </svg>
  </span>
  {%- endmacro %}

  <section class="material-title" lang="ar" aria-label="Judul materi">
    <div class="title-ornament" aria-hidden="true"></div>
    <div class="material-title-text">{% for token in qae.material_title %}{{ qae_token(token) }}{% endfor %}</div>
    <div class="title-ornament" aria-hidden="true"></div>
  </section>

  <section class="exercise-area" aria-label="Latihan membaca">
    <section class="exercise-section singles-section"><div class="group singles">{% for token in qae.singles %}<div class="object">{{ qae_token(token) }}</div>{% endfor %}</div></section>
    <section class="exercise-section pairs-section"><div class="group pairs">{% for item in qae.pairs %}<div class="object">{% for token in item %}{{ qae_token(token) }}{% endfor %}</div>{% endfor %}</div></section>
    <section class="exercise-section triples-section"><div class="group triples">{% for item in qae.triples %}<div class="object">{% for token in item %}{{ qae_token(token) }}{% endfor %}</div>{% endfor %}</div></section>
  </section>

  <footer class="footer">
    <div class="field"><strong>{{ footer.teacher_label }}</strong><span class="line"></span></div>
    <div class="field"><strong>{{ footer.date_label }}</strong><span class="line"></span></div>
    <div class="field"><strong>{{ footer.score_label }}</strong><span class="line"></span></div>
  </footer>
  <div class="bottom-band"></div>
</main>
</body>
</html>
