<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ identity.title }} — Jilid {{ volume }} Halaman {{ '%02d'|format(page) }}</title>
  <link rel="stylesheet" href="{{ css_uri }}">
</head>
<body>
<main class="page">
  <header class="header">
    <div class="brand">{{ identity.title }}</div>
    <div class="heading">
      <div class="subtitle">{{ identity.subtitle }}</div>
      <div class="ornament">━━ ◇ ━━</div>
    </div>
    <div class="page-number">{{ '%02d'|format(page) }}</div>
  </header>

  <section class="material-title" lang="ar">
    {% for item in material_title %}<span>{{ item }}</span>{% endfor %}
  </section>

  <section class="exercise-area" aria-label="Latihan membaca">
    <div class="group singles">
      {% for item in objects.singles %}<div class="object">{{ item }}</div>{% endfor %}
    </div>
    <div class="group pairs">
      {% for item in objects.pairs %}<div class="object">{{ item|join(' ') }}</div>{% endfor %}
    </div>
    <div class="group triples">
      {% for item in objects.triples %}<div class="object">{{ item|join(' ') }}</div>{% endfor %}
    </div>
  </section>

  <section class="targets">
    <div class="label">TARGET CAPAIAN</div>
    <div class="item">Progres materi<strong>{{ targets.material_progress }}</strong></div>
    <div class="item">Hafalan surat<strong>{{ targets.memorization }}</strong></div>
    <div class="item">Nidom / Hadits<strong>{{ targets.nidom_hadith }}</strong></div>
    <div class="item">Bahasa Arab<strong>{{ targets.arabic_language }}</strong></div>
  </section>

  <footer class="footer">
    <div class="field"><strong>{{ footer.teacher_label }}</strong><span class="line"></span></div>
    <div class="field"><strong>{{ footer.date_label }}</strong><span class="line"></span></div>
    <div class="field"><strong>{{ footer.score_label }}</strong><span class="line"></span></div>
  </footer>
  <div class="bottom-band"></div>
</main>
</body>
</html>
