<!doctype html>
<html lang="id" data-layout-debug="{{ 'true' if layout_debug else 'false' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ identity.title }} — Jilid {{ volume }} Halaman {{ '%02d'|format(page) }}</title>
  <link rel="stylesheet" href="{{ css_uri }}">
</head>
<body>
<main class="page canonical-page" data-page-number="{{ page }}" data-qae-profile="{{ qae.profile }}">
  <header class="header">
    <div class="brand-block" aria-label="Identitas QURBATA"><img class="brand-logo" src="{{ logo_uri }}" alt="Logo QURBATA"></div>
    <div class="heading"><div class="subtitle">{{ identity.subtitle }}</div><div class="ornament" aria-hidden="true"><span></span><b>◇</b><span></span></div></div>
    <div class="page-number">{{ '%02d'|format(page) }}</div>
  </header>

  <section class="targets canonical-targets" aria-label="Target capaian halaman">
    <div class="targets-label">TARGET CAPAIAN</div>
    <div class="target-item"><span>Progres</span><strong>{{ targets.material_progress }}</strong></div>
    <div class="target-item competency-target"><span>Kompetensi</span><strong>{{ targets.competencies }}</strong></div>
    <div class="target-item"><span>Hafalan</span><strong>{{ targets.memorization }}</strong></div>
    <div class="target-item"><span>Bahasa Arab</span><strong>{{ targets.arabic_language }}</strong></div>
  </section>

  {% macro qae_token(token) -%}
  <span class="arabic-token qae-token qae-{{ token.mark }}" style="{{ token.style }}" aria-label="{{ token.source }}">
    <span class="arabic-base">{{ token.base }}</span>
    <svg class="qae-mark qae-mark-{{ token.mark }}" viewBox="{{ token.svg.view_box }}" aria-hidden="true" focusable="false">
      <path d="{{ token.svg.path_d }}" fill="none" stroke="{{ token.svg.color }}" stroke-width="{{ token.svg.stroke_width }}" stroke-linecap="round" />
    </svg>
  </span>
  {%- endmacro %}

  <section class="canonical-title" lang="ar" aria-label="Materi halaman">
    <div class="title-ornament" aria-hidden="true"></div>
    <strong>{{ targets.competencies }}</strong>
    <div class="title-ornament" aria-hidden="true"></div>
  </section>

  <section class="canonical-grid" aria-label="24 objek latihan membaca">
    {% for item in objects %}
    <article class="canonical-object object-type-{{ item.object_type|lower }} render-mode-{{ item.render_mode }}" data-slot="{{ item.slot }}" data-object-id="{{ item.object_id }}" data-source-ref="{{ item.source_ref }}">
      <span class="slot-number">{{ item.slot }}</span>
      <div class="canonical-arabic" lang="ar" dir="rtl">
        {% if item.render_mode == 'qae-short-vowel' %}
          {% for token in item.qae_tokens %}{{ qae_token(token) }}{% endfor %}
        {% else %}
          <span class="raw-quran-text">{{ item.text }}</span>
        {% endif %}
      </div>
    </article>
    {% endfor %}
  </section>

  <footer class="footer">
    <div class="field"><strong>{{ footer.teacher_label }}</strong><span class="line"></span></div>
    <div class="field"><strong>{{ footer.date_label }}</strong><span class="line"></span></div>
    <div class="field"><strong>{{ footer.score_label }}</strong><span class="line"></span></div>
  </footer>
  <div class="bottom-band"></div>
</main>
</body>
</html>
