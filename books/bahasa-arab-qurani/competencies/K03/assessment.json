{"competency":"K03","status":"DRAFT_BANK_QA_REQUIRED","target":"Mengenali tanwin secara visual pada isim sederhana","items":[{"id":"K03-A01","level":"recognition","prompt":"Mana yang memiliki tanwin?","stimulus":["أَحَدٌ","ٱلصَّمَدُ"],"answer":"أَحَدٌ"},{"id":"K03-A02","level":"recognition","prompt":"Mana yang memiliki tanwin?","stimulus":["خُسْرٍ","ٱلْإِنسَانَ"],"answer":"خُسْرٍ"},{"id":"K03-A03","level":"recognition","prompt":"Mana yang memiliki tanwin?","stimulus":["نَارًا","ٱلْحَطَبِ"],"answer":"نَارًا"},{"id":"K03-A04","level":"recognition","prompt":"Tandai dua harakat di akhir kata.","stimulus":"حَبْلٌ","answer":"ٌ"},{"id":"K03-A05","level":"recognition","prompt":"Tandai dua harakat di akhir kata.","stimulus":"عَلَقٍ","answer":"ٍ"},{"id":"K03-A06","level":"recognition","prompt":"Tandai dua harakat di akhir kata.","stimulus":"كُفُوًا","answer":"ً"},{"id":"K03-A07","level":"comprehension","prompt":"Tanwin apakah ini?","stimulus":"أَحَدٌ","answer":"tanwin dhammah"},{"id":"K03-A08","level":"comprehension","prompt":"Tanwin apakah ini?","stimulus":"خُسْرٍ","answer":"tanwin kasrah"},{"id":"K03-A09","level":"comprehension","prompt":"Tanwin apakah ini?","stimulus":"نَارًا","answer":"tanwin fathah"},{"id":"K03-A10","level":"boundary","prompt":"Apakah semua isim nakirah selalu harus terlihat bertanwin?","answer":"Tidak","explanation":"K03 memakai tanwin sebagai bukti visual yang mudah, bukan sebagai seluruh teori nakirah."},{"id":"K03-A11","level":"application","prompt":"Temukan kata bertanwin.","stimulus":"إِنَّ ٱلْإِنسَانَ لَفِى خُسْرٍ","answer":["خُسْرٍ"]},{"id":"K03-A12","level":"application","prompt":"Temukan kata bertanwin.","stimulus":"مِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","answer":["غَاسِقٍ"]},{"id":"K03-A13","level":"application","prompt":"Temukan kata bertanwin.","stimulus":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","answer":["حَاسِدٍ"]},{"id":"K03-A14","level":"application","prompt":"Temukan kata bertanwin.","stimulus":"خَلَقَ ٱلْإِنسَانَ مِنْ عَلَقٍ","answer":["عَلَقٍ"]},{"id":"K03-A15","level":"application","prompt":"Temukan kata bertanwin.","stimulus":"سَيَصْلَىٰ نَارًا ذَاتَ لَهَبٍ","answer":["نَارًا","لَهَبٍ"]},{"id":"K03-A16","level":"application","prompt":"Temukan kata bertanwin.","stimulus":"فِى جِيدِهَا حَبْلٌ مِّن مَّسَدٍ","answer":["حَبْلٌ","مَسَدٍ"]},{"id":"K03-A17","level":"application","prompt":"Temukan kata bertanwin.","stimulus":"يَدْخُلُونَ فِى دِينِ ٱللَّهِ أَفْوَاجًا","answer":["أَفْوَاجًا"]},{"id":"K03-A18","level":"application","prompt":"Temukan kata bertanwin.","stimulus":"إِنَّهُۥ كَانَ تَوَّابًا","answer":["تَوَّابًا"]},{"id":"K03-A19","level":"analysis","prompt":"Apa ciri visual yang sama pada أَحَدٌ، حَبْلٌ، عَابِدٌ?","answer":"Ada dua dhammah/tanwin dhammah di akhir."},{"id":"K03-A20","level":"analysis","prompt":"Apa ciri visual yang sama pada خُسْرٍ، عَلَقٍ، مَسَدٍ?","answer":"Ada dua kasrah/tanwin kasrah di akhir."},{"id":"K03-A21","level":"analysis","prompt":"Apa ciri visual yang sama pada نَارًا، كُفُوًا، أَفْوَاجًا?","answer":"Ada tanwin fathah di akhir."},{"id":"K03-A22","level":"compare","prompt":"Mana yang bertanwin: ٱلصَّمَدُ atau أَحَدٌ?","answer":"أَحَدٌ"},{"id":"K03-A23","level":"compare","prompt":"Mana yang bertanwin: ٱلْفَلَقِ atau غَاسِقٍ?","answer":"غَاسِقٍ"},{"id":"K03-A24","level":"boundary","prompt":"Apakah K03 meminta peserta menentukan i'rab خُسْرٍ?","answer":"Tidak"},{"id":"K03-A25","level":"transfer","prompt":"Temukan kata bertanwin pada evidence baru.","stimulus":"صَغَارٌ عِندَ ٱللَّهِ وَعَذَابٌ شَدِيدٌ","answer":["صَغَارٌ","عَذَابٌ","شَدِيدٌ"]},{"id":"K03-A26","level":"transfer","prompt":"Temukan kata bertanwin pada evidence baru.","stimulus":"جَنَّاتٍ مَّعْرُوشَاتٍ","answer":["جَنَّاتٍ","مَعْرُوشَاتٍ"]},{"id":"K03-A27","level":"transfer","prompt":"Pilih yang bertanwin.","stimulus":["عِلْمٍ","أَجَلَنَا"],"answer":"عِلْمٍ"},{"id":"K03-A28","level":"transfer","prompt":"Pilih yang bertanwin.","stimulus":["سَفَهًا","غَيْرَ"],"answer":"سَفَهًا"},{"id":"K03-A29","level":"transfer","prompt":"Pilih yang bertanwin.","stimulus":["ظُفُرٍ","ٱلَّذِينَ"],"answer":"ظُفُرٍ"},{"id":"K03-A30","level":"reflection","prompt":"Apa kemampuan utama K03?","answer":"Mampu menemukan tanda tanwin pada isim Qurani sederhana tanpa harus mengetahui arti seluruh ayat."}],"qaNote":"Full Uthmani stimulus normalization required before PDF freeze. Answer key is embedded for backend and can be separated in student output."}